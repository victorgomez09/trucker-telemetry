<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="1" author="viti">
        <createTable tableName="jobs">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="source_city" type="VARCHAR(64)" />
            <column name="destination_city" type="VARCHAR(64)" />
            <column name="cargo_name" type="VARCHAR(64)" />
            <column name="income" type="BIGINT" />
            <column name="distance_km" type="INT" />
            <column name="cargo_damage_perc" type="FLOAT" />
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP" />
        </createTable>
    </changeSet>

    <changeSet id="2" author="viti">
        <createTable tableName="job_events">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="job_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_job_events_job"
                    referencedTableName="jobs" referencedColumnNames="id" />
            </column>
            <column name="event_type" type="INT" />
            <column name="description" type="VARCHAR(255)" />
            <column name="amount" type="BIGINT" />
            <column name="timestamp_game" type="BIGINT" />
        </createTable>
    </changeSet>

    <changeSet id="3" author="viti">
        <addColumn tableName="jobs">
            <column name="truck_model" type="VARCHAR(64)" />
            <column name="total_fuel_consumed" type="FLOAT" />
        </addColumn>
    </changeSet>

    <changeSet id="4" author="viti">
        <addColumn tableName="jobs">
            <column name="truck_name" type="VARCHAR(64)" />
        </addColumn>
    </changeSet>

    <changeSet id="5" author="viti">
        <createTable tableName="refuels">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="job_id" type="BIGINT">
                <constraints foreignKeyName="fk_refuel_job" referencedTableName="jobs"
                    referencedColumnNames="id" />
            </column>
            <column name="liters" type="FLOAT" />
            <column name="total_cost" type="FLOAT" />
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP" />
        </createTable>
    </changeSet>

</databaseChangeLog>